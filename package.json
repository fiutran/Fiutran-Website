{
  "name": "fiutran-website",
  "version": "0.1.0",
  "private": true,
  "description": "Fiutran website: clickable skeleton prototype with real SEO/AEO/GEO/GSEO infrastructure",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/link-graph.mjs",
    "start": "node scripts/serve.mjs",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "audit": "node scripts/audit.mjs",
    "e2e": "node scripts/e2e.mjs",
    "lighthouse": "node scripts/lighthouse.mjs",
    "verify": "npm run build && npm run audit && npm run e2e"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^15.5.28",
    "next": "^15.5.28",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/mdx": "^2.0.14",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "lighthouse": "^12.8.2",
    "playwright": "^1.56.1",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3"
  }
}
